# ==========================================
# Application
# ==========================================

APP_ENV=development
APP_NAME=criminal-network-analysis


# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=criminal_network
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# ==========================================
# Neo4j
# ==========================================

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me


# ==========================================
# Backend
# ==========================================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010


# ==========================================
# Frontend
# ==========================================

VITE_API_BASE_URL=http://127.0.0.1:8010
# Set to api to use FastAPI JWT authentication; mock is the safe local demo default.
VITE_AUTH_MODE=mock
VITE_GRAPH_MODE=mock


# ==========================================
# Security
# ==========================================

JWT_SECRET=replace_with_at_least_32_random_utf8_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
